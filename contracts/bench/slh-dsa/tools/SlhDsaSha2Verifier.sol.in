/// @title @@TITLE@@
/// @notice FIPS 205 SLH-DSA verification for one parameter set of the SHA2 instantiation at security category 1
///         (section 11.2.1): F, H and T_l are SHA-256 over PK.seed padded to a 64-byte block, the 22-byte compressed
///         address ADRSc and the input; H_msg is MGF1-SHA-256. Every hash goes through the SHA-256 precompile (0x02).
@@DRAFT_NOTICE@@///         Parameters: @@PARAMS_LINE@@
///         Public key @@PK_BYTES@@ bytes (PK.seed | PK.root), signature @@SIG_BYTES@@ bytes.
/// @dev    A benchmark, not audited. Malformed input (lengths, a context over 255 bytes) returns false, never reverts.
///         Memory is laid out by hand (below) and every entry point ends with RETURN, so no Solidity code runs after
///         the assembly. Precompile calls are not checked for success: SHA-256 can only fail by running out of gas,
///         and the 63/64 rule then leaves about 1/63 of the call's price, too little to reach RETURN (README.md).
contract @@CONTRACT@@ {
    // --- parameters (FIPS 205 Table 2 and the formulas of sections 5, 9 and 10, computed by tools/gen.py) ---
@@CONSTANTS@@
    // --- memory ---
    // 0x000 | F and H input: PK.seed (16) | 48 zero bytes | ADRSc (22) at 0x40 | M at 0x56 (F: 16 bytes, H: 32)
    // 0x0c0 | a hash output read back (a layer's root, PK_FORS)
    // 0x0e0 | the digest
    // 0x100 | T_l input: PK.seed | zeros | ADRSc at 0x140 | the FORS roots or WOTS chain ends from 0x156
    // MSG   | H_msg input: R (16) | PK.seed (16) | PK.root (16) | M'
    uint256 private constant T_BUF = 0x100;
    uint256 private constant OUT = 0xc0;
    uint256 private constant DIG = 0xe0;
    uint256 private constant MSG = @@MSG@@;
    uint256 private constant HIGH = 0xffffffffffffffffffffffffffffffff00000000000000000000000000000000;

    /// @notice FIPS 205 Algorithm 24, slh_verify, pure SLH-DSA with an empty context: M' = 0x00 | 0x00 | M.
    function verify(bytes calldata pk, bytes calldata message, bytes calldata signature) external view returns (bool) {
        assembly {
            mstore(add(MSG, 0x30), 0) // toByte(0, 1) | toByte(0, 1)
            calldatacopy(add(MSG, 0x32), message.offset, message.length)
        }
        _verify(pk, signature, 2 + message.length);
    }

    /// @notice FIPS 205 Algorithm 24, slh_verify, pure SLH-DSA: M' = 0x00 | len(ctx) | ctx | M.
    function verifyWithContext(bytes calldata pk, bytes calldata ctx, bytes calldata message, bytes calldata signature)
        external
        view
        returns (bool)
    {
        if (ctx.length > 255) return false;
        assembly {
            mstore(add(MSG, 0x30), shl(240, ctx.length)) // toByte(0, 1) | toByte(|ctx|, 1)
            calldatacopy(add(MSG, 0x32), ctx.offset, ctx.length)
            calldatacopy(add(add(MSG, 0x32), ctx.length), message.offset, message.length)
        }
        _verify(pk, signature, 2 + ctx.length + message.length);
    }

    /// @notice FIPS 205 Algorithm 20, slh_verify_internal, on M' as given (for ACVP's internal-interface vectors).
    function verifyInternal(bytes calldata pk, bytes calldata mPrime, bytes calldata signature)
        external
        view
        returns (bool)
    {
        assembly {
            calldatacopy(add(MSG, 0x30), mPrime.offset, mPrime.length)
        }
        _verify(pk, signature, mPrime.length);
    }

    /// @dev Algorithm 20 on M' at MSG + 0x30 (mLen bytes). Ends the call with RETURN.
    function _verify(bytes calldata pk, bytes calldata signature, uint256 mLen) private view {
        assembly {
            /// Algorithm 17, fors_pkFromSig: PK_FORS for the digest's k indices.
            function fors(dig, idxTree, idxLeaf, sig) -> pkFors {
                // FORS_TREE address of key pair idx_leaf in tree idx_tree of layer 0, as a 22-byte value:
                // layer (1) | tree (8) | type (1) | key pair (4) | tree height (4) | tree index (4)
                let base := or(or(shl(104, idxTree), shl(96, 3)), shl(64, idxLeaf))
                mstore(0x36, base) // the whole ADRSc once; later writes from 0x46 leave its first 6 bytes alone
                let p := add(sig, 16) // SIG_FORS
                for { let i := 0 } lt(i, K) { i := add(i, 1) } {
                    let idx := and(shr(sub(256, mul(A, add(i, 1))), dig), A_MASK)
                    let leaf := add(shl(A, i), idx)
                    // node = F(PK.seed, ADRS(height 0, index i 2^a + idx), sk), written where the first H wants it
                    mstore(0x46, or(shl(128, or(base, leaf)), shr(128, calldataload(p))))
                    pop(staticcall(gas(), 2, 0, 102, add(0x56, shl(4, and(idx, 1))), 0x20))
                    // H up to height a, unrolled: the running node sits in the left (bit 0) or right half of M2
                    @@FORS_LEVELS@@
                    p := add(p, FORS_TREE_BYTES)
                }
                // PK_FORS = T_k(PK.seed, FORS_ROOTS address of the key pair, roots)
                mstore(add(T_BUF, 0x36), or(or(shl(104, idxTree), shl(96, 4)), shl(64, idxLeaf)))
                pop(staticcall(gas(), 2, T_BUF, T_K_BYTES, OUT, 0x20))
                pkFors := and(mload(OUT), HIGH)
            }

            /// Algorithms 8 and 11 for one XMSS layer: the WOTS+ public key from the signature at sigp over msg,
            /// then up the h' authentication path. Returns the layer's root.
            /// `top` is the address's layer and tree: layer << 168 | idx_tree << 104.
            function xmss(msg, sigp, top, idxLeaf) -> root {
                let wots := or(top, shl(64, idxLeaf)) // WOTS_HASH, key pair idx_leaf
                mstore(0x36, wots)
                let csum := 0
                let i := 0
                // chain(sig_i, a, w - 1 - a) for msg's digits (Algorithm 8 lines 1-7), then the checksum's. The chain
                // ends go straight into T_len's input.
                for {} lt(i, LEN1) { i := add(i, 1) } {
                    let a := and(shr(sub(MSG_SHIFT, mul(LGW, i)), msg), W1)
                    csum := add(csum, sub(W1, a))
                    @@CHAIN@@
                }
                for {} lt(i, LEN) { i := add(i, 1) } {
                    let a := and(shr(sub(CSUM_SHIFT, mul(LGW, i)), csum), W1)
                    @@CHAIN@@
                }
                // pk = T_len(PK.seed, WOTS_PK address, chain ends), written where the first H wants it
                mstore(add(T_BUF, 0x36), or(wots, shl(96, 1)))
                pop(staticcall(gas(), 2, T_BUF, T_LEN_BYTES, add(0x56, shl(4, and(idxLeaf, 1))), 0x20))
                // up the tree, unrolled: TREE address, height k, index idx_leaf >> k
                let tree := or(top, shl(96, 2))
                @@XMSS_LEVELS@@
                root := and(mload(OUT), HIGH)
            }

            if or(iszero(eq(pk.length, 32)), iszero(eq(signature.length, SIG_BYTES))) {
                mstore(0, 0)
                return(0, 0x20)
            }
            let pkOff := pk.offset
            let sigOff := signature.offset
            let seed := and(calldataload(pkOff), HIGH)
            let pkRoot := and(calldataload(add(pkOff, 16)), HIGH)

            // digest = H_msg(R, PK.seed, PK.root, M') = MGF1-SHA-256(R | PK.seed | SHA-256(R | PK.seed | PK.root | M'), m)
            calldatacopy(MSG, sigOff, 16) // R
            calldatacopy(add(MSG, 0x10), pkOff, 32) // PK.seed | PK.root
            pop(staticcall(gas(), 2, MSG, add(48, mLen), add(MSG, 0x20), 0x20)) // over PK.root: R | PK.seed | inner
            mstore(add(MSG, 0x40), 0) // MGF1's counter 0; m <= 32 bytes takes one block
            pop(staticcall(gas(), 2, MSG, 0x44, DIG, 0x20))
            let dig := mload(DIG)
            let idxTree := and(shr(TREE_SHIFT, dig), TREE_MASK)
            let idxLeaf := and(shr(LEAF_SHIFT, dig), HP_MASK)

            // PK.seed padded to a block, for F and H at 0 and T_l at T_BUF
            mstore(0, seed)
            mstore(0x20, 0)
            mstore(T_BUF, seed)
            mstore(add(T_BUF, 0x20), 0)

            let root := fors(dig, idxTree, idxLeaf, sigOff)
            // Algorithm 13, ht_verify
            let sigp := add(sigOff, HT_OFFSET)
            for { let layer := 0 } lt(layer, D) { layer := add(layer, 1) } {
                root := xmss(root, sigp, or(shl(168, layer), shl(104, idxTree)), idxLeaf)
                sigp := add(sigp, XMSS_BYTES)
                idxLeaf := and(idxTree, HP_MASK)
                idxTree := shr(HP, idxTree)
            }
            mstore(0, eq(root, pkRoot))
            return(0, 0x20)
        }
    }
