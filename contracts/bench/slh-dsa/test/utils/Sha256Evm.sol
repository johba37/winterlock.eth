pragma solidity ^0.8.24;

/// One SHA-256 compression (FIPS 180-4) in EVM code, from a given state: what a verifier would run per hash if it
/// kept PK.seed's midstate instead of calling the precompile, which cannot resume from one. Straightforward Yul:
/// loops, the message schedule in memory, the working variables on the stack. Test only; compiled with via-IR
/// (foundry.toml), as the legacy pipeline runs out of stack.
contract Sha256Evm {
    bytes internal constant K =
        hex"";

    /// state: 8 words (one 32-bit value each); block: 64 bytes
    function compress(uint256[8] memory state, bytes memory blk) public pure returns (uint256[8] memory out) {
        bytes memory k = K;
        assembly {
            let M := 0xffffffff
            let w := mload(0x40)
            mstore(0x40, add(w, 0x800))
            for { let t := 0 } lt(t, 16) { t := add(t, 1) } {
                mstore(add(w, shl(5, t)), shr(224, mload(add(add(blk, 0x20), shl(2, t)))))
            }
            for { let t := 16 } lt(t, 64) { t := add(t, 1) } {
                let x := mload(add(w, shl(5, sub(t, 15))))
                let y := mload(add(w, shl(5, sub(t, 2))))
                let s0 := xor(xor(or(shr(7, x), and(shl(25, x), M)), or(shr(18, x), and(shl(14, x), M))), shr(3, x))
                let s1 := xor(xor(or(shr(17, y), and(shl(15, y), M)), or(shr(19, y), and(shl(13, y), M))), shr(10, y))
                mstore(
                    add(w, shl(5, t)),
                    and(add(add(mload(add(w, shl(5, sub(t, 16)))), s0), add(mload(add(w, shl(5, sub(t, 7)))), s1)), M)
                )
            }
            let a := mload(state)
            let b := mload(add(state, 0x20))
            let c := mload(add(state, 0x40))
            let d := mload(add(state, 0x60))
            let e := mload(add(state, 0x80))
            let f := mload(add(state, 0xa0))
            let g := mload(add(state, 0xc0))
            let h := mload(add(state, 0xe0))
            let kp := add(k, 0x20)
            for { let t := 0 } lt(t, 64) { t := add(t, 1) } {
                let s1 :=
                    xor(
                        xor(or(shr(6, e), and(shl(26, e), M)), or(shr(11, e), and(shl(21, e), M))),
                        or(shr(25, e), and(shl(7, e), M))
                    )
                let t1 :=
                    add(
                        add(add(h, s1), xor(and(e, f), and(not(e), g))),
                        add(mload(add(kp, shl(5, t))), mload(add(w, shl(5, t))))
                    )
                let s0 :=
                    xor(
                        xor(or(shr(2, a), and(shl(30, a), M)), or(shr(13, a), and(shl(19, a), M))),
                        or(shr(22, a), and(shl(10, a), M))
                    )
                let t2 := add(s0, xor(xor(and(a, b), and(a, c)), and(b, c)))
                h := g
                g := f
                f := e
                e := and(add(d, t1), M)
                d := c
                c := b
                b := a
                a := and(add(t1, t2), M)
            }
            mstore(out, and(add(mload(state), a), M))
            mstore(add(out, 0x20), and(add(mload(add(state, 0x20)), b), M))
            mstore(add(out, 0x40), and(add(mload(add(state, 0x40)), c), M))
            mstore(add(out, 0x60), and(add(mload(add(state, 0x60)), d), M))
            mstore(add(out, 0x80), and(add(mload(add(state, 0x80)), e), M))
            mstore(add(out, 0xa0), and(add(mload(add(state, 0xa0)), f), M))
            mstore(add(out, 0xc0), and(add(mload(add(state, 0xc0)), g), M))
            mstore(add(out, 0xe0), and(add(mload(add(state, 0xe0)), h), M))
        }
    }

    /// The same compression, measured with gasleft inside the callee
    function compressGas(uint256[8] memory state, bytes memory blk)
        external
        view
        returns (uint256[8] memory out, uint256 used)
    {
        used = gasleft();
        out = compress(state, blk);
        used -= gasleft();
    }
}
